# Copy to .env.local and fill in from Supabase → Project Settings → API
# Never commit .env.local (it is gitignored).

# Project URL, e.g. https://abcdefghijklmnop.supabase.co
VITE_SUPABASE_URL=

# Publishable key (safe in the browser) — starts with sb_publishable_
# Or legacy "anon" JWT from API Keys → Legacy tab
VITE_SUPABASE_PUBLISHABLE_KEY=

# --- Google Auth (Supabase Dashboard — not env vars) ---
# 1. Authentication → Providers → Google → Enable
# 2. Create OAuth client in Google Cloud Console (Web application)
# 3. Authorized redirect URI (Supabase callback):
#    https://<PROJECT_REF>.supabase.co/auth/v1/callback
# 4. Paste Client ID + Client Secret into Supabase Google provider
# 5. Authentication → URL Configuration:
#    Site URL: http://localhost:3000 (dev) / your Vercel URL (prod)
#    Redirect URLs: http://localhost:3000/** and https://<your-app>.vercel.app/**

# Optional: for npm run db:migrate:002 (Settings -> Database -> Connection string -> URI)
# SUPABASE_DB_URL=

# Optional: for npm run db:migrate:* (Settings → Database → Connection string → URI)
# SUPABASE_DB_URL=
# Or paste the SQL file in Supabase → SQL Editor (e.g. 008_rls_admin_writes.sql).
